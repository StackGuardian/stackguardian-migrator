# bash 3.2.57 (the macOS /bin/bash) as /bin/bash on Debian, with an old jq
# (Debian 12's 1.6): catches bash-4-only syntax and bash 3.2 expansion quirks
# without a Mac, and jq features newer than what native users may have.
FROM debian:bookworm-slim

ARG BASH32_VERSION=3.2.57
ARG HCL2JSON_VERSION=0.6.7
ARG BATS_VERSION=1.11.1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential autotools-dev bison curl ca-certificates git jq python3 \
    && rm -rf /var/lib/apt/lists/*

# bash 3.2 predates C99 defaults (gnu89, no -Werror) and aarch64 (current
# config.guess/config.sub from autotools-dev); bison regenerates the parser.
RUN curl -fsSL "https://ftp.gnu.org/gnu/bash/bash-${BASH32_VERSION}.tar.gz" | tar -xz -C /tmp \
    && cd "/tmp/bash-${BASH32_VERSION}" \
    && cp /usr/share/misc/config.guess /usr/share/misc/config.sub support/ \
    && CFLAGS="-O2 -std=gnu89 -Wno-error" \
       ./configure --prefix=/opt/bash32 --without-bash-malloc >/dev/null \
    && make -s -j"$(getconf _NPROCESSORS_ONLN)" >/dev/null 2>&1 \
    && make -s install >/dev/null \
    && cd / && rm -rf "/tmp/bash-${BASH32_VERSION}"

RUN arch="$(dpkg --print-architecture)" \
    && curl -fsSL "https://github.com/tmccombs/hcl2json/releases/download/v${HCL2JSON_VERSION}/hcl2json_linux_${arch}" -o /usr/local/bin/hcl2json \
    && chmod +x /usr/local/bin/hcl2json \
    && curl -fsSL "https://github.com/bats-core/bats-core/archive/refs/tags/v${BATS_VERSION}.tar.gz" | tar -xz -C /tmp \
    && "/tmp/bats-core-${BATS_VERSION}/install.sh" /usr/local \
    && rm -rf "/tmp/bats-core-${BATS_VERSION}"

# Last, so apt and the builds above still ran on Debian's bash 5.
RUN ln -sf /opt/bash32/bin/bash /usr/bin/bash && /bin/bash -c 'case "$BASH_VERSION" in 3.2.*) ;; *) exit 1 ;; esac'

ENV SG_CACHE_DIR=/tmp/sg-cache
WORKDIR /app
ENTRYPOINT ["/bin/bash"]
